# Production environment for the Next.js frontend (Hostinger).
#
# IMPORTANT: every NEXT_PUBLIC_* value is baked into the build. Set them BEFORE `npm run build`
# (copy this file to .env.production, or add them as environment variables in hPanel before the
# build runs). Changing one later means rebuilding.

# Public API base URL INCLUDING the /api prefix. The Next.js server calls this for almost all data.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api

# The website's own public address (canonical URLs, Open Graph, sitemap) - no trailing slash.
# The admin dashboards also call the site's own /api routes through this URL, so it must be
# reachable from the server itself over HTTPS.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Bunny.net pull-zone HOST only (no https://, no path). Must equal the host of the backend's
# BUNNY_PULL_ZONE_URL, otherwise article images are rejected by next/image.
NEXT_PUBLIC_BUNNY_PULL_ZONE_HOST=truth-social-media.b-cdn.net

NEXT_PUBLIC_SITE_NAME=Truth & Social

# Optional social profile overrides (defaults are set in components/SocialLinks.tsx).
# X and Telegram stay hidden until a URL is set.
# NEXT_PUBLIC_SOCIAL_X=https://x.com/yourhandle
# NEXT_PUBLIC_SOCIAL_TELEGRAM=https://t.me/yourchannel
