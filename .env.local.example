# Phase 7: public Next.js website environment variables.
# Copy this file to .env.local (dev) or set these in your hosting
# provider's environment (production) - never commit the real .env.local.

# Base URL of the Django REST API, including the /api prefix.
# Server components (this app fetches almost everything server-side) call
# this directly - it does not need to be reachable from the browser unless
# you later add client-side fetching.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# The public site's own canonical origin, used for canonical URLs, Open
# Graph og:url, and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Bunny.net pull-zone hostname only (no protocol, no path) - must match the
# backend's BUNNY_PULL_ZONE_URL host, e.g. "my-zone.b-cdn.net". Required so
# next/image is allowed to optimize Bunny-hosted images.
NEXT_PUBLIC_BUNNY_PULL_ZONE_HOST=truth-social-media.b-cdn.net

# Site name used in titles/OG metadata/JSON-LD Organization name.
NEXT_PUBLIC_SITE_NAME=Truth & Social

# Public contact e-mail shown on the Contact, Advertise, Privacy and Terms pages. Leave it empty and no
# e-mail address is shown (the pages then point readers to the social channels instead).
NEXT_PUBLIC_CONTACT_EMAIL=
